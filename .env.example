# Copy to .env and fill in. Never commit .env.

# App
APP_PORT=8088
LOG_LEVEL=INFO
POLICY_PAYOUT_CEILING=10000

# AI adjudication. Leave AI_BASE_URL empty to use the built-in stub model.
# Direct provider:   AI_BASE_URL=https://api.openai.com/v1   AI_API_KEY=sk-...
# Through Warden:    AI_BASE_URL=<relay base url>            AI_API_KEY=<relay key>
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Elastic Cloud (used by Filebeat only)
ELASTIC_ENDPOINT=
ELASTIC_API_KEY=
